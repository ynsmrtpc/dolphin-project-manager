# Uygulamanin calisacagi port
PORT=3000

# Uygulamanin dis adresi (GitHub OAuth callback bu adresi kullanir)
APP_URL=http://localhost:3000

# GitHub OAuth App bilgileri -> https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SQLite veritabani dosyasi
DATABASE_PATH=./data/dolphin.db

# Issue/PR onbellegi bu dakikadan eskiyse sekme acildiginda tazelenir (varsayilan 360)
ISSUE_SYNC_TTL_MINUTES=360

# Token sifreleme anahtari. Bos birakilirsa data/.encryption-key dosyasi uretilir.
# Uretimde bunu doldurup anahtari veritabanindan ayri tutmak daha guvenlidir.
ENCRYPTION_KEY=

# Depo meta verisi (yildiz, aciklama, son push) bu dakikadan eskiyse tazelenir
REPO_SYNC_TTL_MINUTES=720
